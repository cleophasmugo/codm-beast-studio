# Copy to .env and adjust. Every setting is optional.

# Require this token on every /api request (enter it in Settings in the web UI). Set it before
# exposing the app beyond your own machine.
BEAST_API_TOKEN=

# Postgres password used by docker-compose (change it for anything but local use)
POSTGRES_PASSWORD=beast
BEAST_PORT=8000

# Limits
BEAST_MAX_UPLOAD_MB=4096
BEAST_MAX_VIDEO_MINUTES=60
BEAST_MAX_AUDIO_MINUTES=30
BEAST_MAX_IMAGE_MEGAPIXELS=50
# Delete uploads and exports older than N days (0 = keep forever)
BEAST_RETENTION_DAYS=0

# Processing
BEAST_WORKER_CONCURRENCY=1
BEAST_JOB_TIMEOUT_SECONDS=3600
BEAST_FFMPEG_THREADS=0
# x264 preset for final exports: ultrafast | veryfast | fast | medium | slow
BEAST_X264_PRESET=veryfast
BEAST_ANALYSIS_FPS=6

# Optional trained game-event detectors, "package.module:ClassName" comma-separated
BEAST_DETECTOR_PLUGINS=

# Local (non-Docker) runs only: leave empty for SQLite + in-process jobs
# BEAST_DATABASE_URL=postgresql+psycopg://beast:beast@localhost:5432/beast
# BEAST_BROKER_URL=redis://localhost:6379/0
# BEAST_DATA_DIR=./data

# Online music search (Openverse). Leave empty to turn it off.
# BEAST_ONLINE_MUSIC_API=https://api.openverse.org/v1
